<resources>
  <style name="AmpyRocketHome" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">monospace</item>
    <item name="android:colorAccent">#00FFE2</item>
    <item name="android:windowShowWallpaper">true</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowIsTranslucent">false</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    <item name="android:enforceNavigationBarContrast">false</item>
    <item name="android:enforceStatusBarContrast">false</item>
    <item name="android:windowActionModeOverlay">true</item>
  </style>
  <style name="AmpyRocketPanel" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">monospace</item>
    <item name="android:colorAccent">#00FFE2</item>
    <item name="android:windowBackground">#070B13</item>
    <item name="android:statusBarColor">#070B13</item>
    <item name="android:navigationBarColor">#070B13</item>
    <item name="android:windowLightStatusBar">false</item>
  </style>
  <style name="AmpyRocketLock" parent="android:style/Theme.Material.NoActionBar.Fullscreen">
    <item name="android:fontFamily">monospace</item>
    <item name="android:windowBackground">#000000</item>
    <item name="android:windowShowWallpaper">false</item>
  </style>
</resources>
